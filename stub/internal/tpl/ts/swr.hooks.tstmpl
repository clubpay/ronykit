{{$serviceName := .Name}}
{{- $types := dict -}}
{{- range .RESTMethods -}}
{{- if and (ne .Name "") (not .Request.Message.IsSpecial) .HasOKResponse -}}
{{- $_ := set $types .Request.Message.Name true -}}
{{- $_ := set $types .GetOKResponse.Message.Name true -}}
{{- end -}}
{{- end -}}

'use client'

// Code generated by RonyKIT Stub Generator (TypeScript); DO NOT EDIT.
import useSWR, { SWRConfiguration } from 'swr'
import {
	{{$serviceName}}Stub,
{{- range $name := (sortAlpha (keys $types)) }}
	{{ $name }},
{{- end }}
} from './stub';

{{/* Generating React Hooks */}}
{{- range .RESTMethods -}}
{{$methodName := .Name}}
{{- if and (ne $methodName "") (not .Request.Message.IsSpecial) .HasOKResponse }}
export function use{{$methodName}}(
	stub: {{$serviceName}}Stub,
	req: {{.Request.Message.Name}},
	reqHeader?: HeadersInit,
	options?: Partial<SWRConfiguration<{{.GetOKResponse.Message.Name}}>>,
	init?: RequestInit,
) {
	return useSWR(
		[req, '{{$methodName}}'],
		([req]) => stub.{{lowerCamelCase $methodName}}(req, reqHeader, init),
		options,
	)
}
{{- end}}
{{- end}}
