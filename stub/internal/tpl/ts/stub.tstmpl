{{/*
		This is a template block to generate a DTO struct
*/}}
{{ define "dto" }}
// {{.Name}} is a data transfer object
{{- $extends := list }}
{{- range .ExportedFields -}}
{{- if .Embedded }}{{$extends = append $extends .Element.Message.Name}}{{end}}
{{- end }}
{{- if gt (len $extends) 0 }}
export interface {{.Name}} extends {{join ", " $extends}} {
{{- else }}
export interface {{.Name}} {
{{- end }}
{{- range .ExportedFields -}}
{{- if .Embedded }}{{continue}}{{end}}
{{- $jsonName := tsJSONName .Name (.Tag.Get "json") }}
{{- if eq $jsonName "" }}{{continue}}{{end}}
	{{$jsonName}}{{ if .Tag.OmitEmpty}}?{{end}}: {{tsType .Element.RType}}{{ if (and .Optional (not .Tag.OmitEmpty)) }} | null{{end}}
{{- end }}
}
{{- $msg := . }}
{{- range .ExportedFields }}
{{- if gt (len .Meta.Enum) 0 }}
export type {{$msg.Name}}_{{.GoName}} = {{ range $i, $enum := .Meta.Enum }}{{if $i}} | {{end}}"{{$enum}}"{{end}};
{{- end }}
{{- end }}
{{- end }}

{{/* Generate the DTO interfaces */}}
// Code generated by RonyKIT Stub Generator (TypeScript); DO NOT EDIT.
{{if eq (.GetOption "withHook") "yes"}}
import useSWR, { SWRConfiguration } from 'swr'
{{end}}

{{ range $dtoName, $dto := .Messages -}}
{{ template "dto" $dto }}
{{ end }}

{{/* Generate the Stub Class */}}
{{$serviceName := .Name}}
export interface RonyErrorPayload {
	code?: string | number;
	codeName?: string;
	item?: string;
	message?: string;
	details?: unknown;
}

export class {{$serviceName}}StubError extends globalThis.Error {
	readonly status: number;
	readonly body: string;
	readonly payload: RonyErrorPayload | null;

	constructor(status: number, body: string) {
		super(`Failed to fetch the data (${status}): ${body}`);
		this.name = '{{$serviceName}}StubError';
		this.status = status;
		this.body = body;
		this.payload = {{$serviceName}}StubError.parsePayload(body);
	}

	get code(): string | number | undefined {
		return this.payload?.codeName ?? this.payload?.code;
	}

	get item(): string | undefined {
		return this.payload?.item;
	}

	get serverMessage(): string {
		return this.payload?.message ?? this.payload?.item ?? `Request failed (${this.status})`;
	}

	get details(): unknown {
		return this.payload?.details;
	}

	private static parsePayload(body: string): RonyErrorPayload | null {
		if (!body) {
			return null;
		}
		try {
			const parsed = JSON.parse(body);
			if (parsed && typeof parsed === 'object') {
				return parsed as RonyErrorPayload;
			}
		} catch {
			// non-JSON error body
		}
		return null;
	}
}

export class {{$serviceName}}Stub {
	readonly serverURL: string;
	private readonly defaultInit: RequestInit;

	constructor(serverURL: string, defaultInit?: RequestInit) {
		this.serverURL = serverURL.replace(/\/$/, '');
		this.defaultInit = defaultInit ?? {};
	}

	private async fetchJSON<T>(path: string, init: RequestInit): Promise<T> {
		const res = await fetch(`${this.serverURL}${path}`, {
			...this.defaultInit,
			...init,
			headers: {
				...(this.defaultInit.headers as Record<string, string> | undefined),
				...(init.headers as Record<string, string> | undefined),
			},
		});
		if (res.status !== 200 && res.status !== 201 && res.status !== 202) {
			throw new {{$serviceName}}StubError(res.status, await res.text());
		}

		const text = await res.text();
		if (!text) {
			return undefined as T;
		}

		return JSON.parse(text) as T;
	}

	private buildQuery(req: Record<string, unknown>, pathParams: string[]): string {
		const exclude = new Set(pathParams);
		const query = new URLSearchParams();
		for (const [key, value] of Object.entries(req)) {
			if (exclude.has(key) || value === undefined || value === null) {
				continue;
			}
			if (Array.isArray(value)) {
				for (const item of value) {
					if (item !== undefined && item !== null && typeof item !== 'object') {
						query.append(key, String(item));
					}
				}
				continue;
			}
			if (typeof value === 'object') {
				continue;
			}
			query.append(key, String(value));
		}
		const qs = query.toString();
		return qs ? `?${qs}` : '';
	}

	{{/*
			Generating the REST methods
	*/}}
	{{- range .RESTMethods -}}
	{{$methodName := .Name}}
	{{- if and (ne $methodName "") (not .Request.Message.IsSpecial) .HasOKResponse }}
	async {{lowerCamelCase $methodName}}(req: {{.Request.Message.Name}}, headers?: HeadersInit, init?: RequestInit): Promise<{{.GetOKResponse.Message.Name}}> {
		{{- if or (eq (lower .Method) "get") (eq (lower .Method) "head") }}
		const queryParams = this.buildQuery(req as Record<string, unknown>, [{{tsPathParamLiterals .PathParams}}]);
		return this.fetchJSON<{{.GetOKResponse.Message.Name}}>(`{{tsReplacePathParams .Path "req."}}${queryParams}`, {
			method: '{{.Method}}',
			...init,
			headers: {
				...headers,
				...init?.headers,
			},
		});
		{{- else }}
		return this.fetchJSON<{{.GetOKResponse.Message.Name}}>(`{{tsReplacePathParams .Path "req."}}`, {
			method: '{{.Method}}',
			...init,
			headers: {
				'Content-Type': 'application/json',
				...headers,
				...init?.headers,
			},
			body: JSON.stringify(req),
		});
		{{- end }}
	}
	{{- end }}
	{{- end }}
}

{{/* Generating React Hooks */}}
{{if eq (.GetOption "withHook") "yes"}}
{{- range .RESTMethods -}}
{{$methodName := .Name}}
{{- if and (ne $methodName "") (not .Request.Message.IsSpecial) .HasOKResponse }}
export function use{{$methodName}}(
	stub: {{$serviceName}}Stub,
	req: {{.Request.Message.Name}} | null | undefined,
	reqHeader?: HeadersInit,
	options?: Partial<SWRConfiguration<{{.GetOKResponse.Message.Name}}, {{$serviceName}}StubError>>,
	init?: RequestInit,
) {
	return useSWR<{{.GetOKResponse.Message.Name}}, {{$serviceName}}StubError>(
		req ? [req, '{{$methodName}}'] : null,
		([r]) => stub.{{lowerCamelCase $methodName}}(r, reqHeader, init),
		options,
	)
}
{{- end}}
{{- end}}
{{- end}}
