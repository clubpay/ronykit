{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/config.local.yaml)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/*.keystore)"
    ]
  },
  "hooks": {
{{- if ne .Kind "frontend" }}
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/backend-lint.sh",
            "timeout": 120
          }
        ]
      }
    ],
{{- end }}
    "Stop": [
      {
        "hooks": [
{{- if ne .Kind "backend" }}
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/frontend-verify.sh",
            "timeout": 900
          }{{ if eq .Kind "fullstack" }},{{ end }}
{{- end }}
{{- if ne .Kind "frontend" }}
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/backend-verify.sh",
            "timeout": 900
          }
{{- end }}
        ]
      }
    ]
  }
}
