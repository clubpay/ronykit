package api

import (
	"go.uber.org/fx"
	"{{.RepositoryPath}}/{{.PackagePath}}/internal/app"
	"{{.RonyKitPath}}/rony"
	"{{.RonyKitPath}}/x/settings"
)

type RContext = rony.UnaryCtx[rony.EMPTY, rony.NOP]

type ServiceParams struct {
	fx.In

	Settings settings.Settings
	App      *app.App
}

// Service is the API adapter. Keep handlers thin: validate, call app, map errors with rony/errs.
type Service struct {
	{{.PackageName}}App *app.App
	settings            settings.Settings
}

func New(params ServiceParams) *Service {
	return &Service{
		{{.PackageName}}App: params.App,
		settings:            params.Settings,
	}
}

func (svc Service) Desc() rony.SetupOption[rony.EMPTY, rony.NOP] {
	return rony.SetupOptionGroup[rony.EMPTY, rony.NOP](
		rony.WithUnary(
			svc.CreateItem,
			rony.POST("/{{.PackageName}}/items", rony.UnaryName("CreateItem")),
		),
	)
}
