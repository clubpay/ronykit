package main

import "{{.RepositoryPath}}/pkg/runner"

func main() {
	runner.Execute(runner.Config{
		ApplicationName: {{printf "%q" .ApplicationName}},
		DisplayName:     {{printf "%q" .ApplicationName}} + " (" + {{printf "%q" .BundleName}} + ")",
		PackageName:     {{printf "%q" .PackageName}},
	})
}
