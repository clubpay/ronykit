# Environment variables read by this workspace. Copy to `.env` and fill in as needed.
# `.env` is gitignored and excluded from Cursor via .cursorignore.
# Every variable below is optional — each package falls back to its own default.

# --- std/llms/ollama (std/llms/ollama/env.go) ---
OLLAMA_MODEL=kimi-k2.7-code:cloud
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- std/llms/langchaingo, OpenAI adapter (std/llms/langchaingo/openai.go) ---
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- x/di config lookup (x/di/service.go) ---
# Overrides the directory searched for service config files.
CONFIG_DIR=

# --- Integration tests (skipped when unset) ---
# std/memories/postgres/postgres_test.go
INTENT_MEMORY_POSTGRES_DSN=
# std/knowledge/milvus/store_test.go
INTENT_KNOWLEDGE_MILVUS_ADDR=
INTENT_KNOWLEDGE_MILVUS_API_KEY=
