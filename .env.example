# Environment variables read by this workspace. Copy to `.env` and fill in as needed.
# `.env` is gitignored and excluded from Cursor via .cursorignore.
# Every variable below is optional — each package falls back to its own default.

# --- x/di config lookup (x/di/service.go) ---
# Overrides the directory searched for service config files.
CONFIG_DIR=

# --- ee Postgres store (std/ee/store/postgres) ---
# Used by postgres.New when no WithPrimary*/WithReplica* option is given.
EE_POSTGRES_PRIMARY_DSN=
# Comma-separated read replicas; View transactions are spread over them.
EE_POSTGRES_REPLICA_DSNS=
# Integration tests (skipped when unset). They TRUNCATE the ee tables, so
# point them at a disposable database. The replica DSN may be any other DB.
EE_POSTGRES_TEST_DSN=
EE_POSTGRES_TEST_REPLICA_DSN=
